generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("POSTGRES_PRISMA_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime? // <- NextAuth lo necesita
  image         String?
  accounts      Account[]
  sessions      Session[]
  wallet        Wallet?
  transactions  Transaction[]
  gameSessions  GameSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? // <- Agregado
  session_state     String? // <- Agregado
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  createdAt DateTime @default(now())

  gameSessionId String?
  gameSession   GameSession? @relation(fields: [gameSessionId], references: [id])

  user User @relation(fields: [userId], references: [id])
}

model GameSession {
  id          String    @id @default(cuid())
  userId      String
  gameType    String
  gameCost    Int
  gameReward  Float?
  result      String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  duration    Int?
  percentLoss Int?
  status      String
  serverSeed  String
  clientSeed  String?
  nonce       Int
  clickCount  Int?

  transactions Transaction[]

  user User @relation(fields: [userId], references: [id])
}
